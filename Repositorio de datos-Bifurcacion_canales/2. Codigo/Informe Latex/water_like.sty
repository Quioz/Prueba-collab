% water_like.sty — Emulación del aspecto de los artículos de la revista Water (MDPI).
% NO es la clase oficial de MDPI (mdpi.cls); reproduce su disposición: Palatino 10 pt, A4, primera
% página con logotipo, etiqueta «Artículo», título en negrita, autores y afiliaciones, recuadro
% lateral de datos del manuscrito junto al resumen, encabezado «Revista Año, N   x de y», secciones
% numeradas en negrita, subsecciones en cursiva, leyendas «Figura 1.» en negrita y tablas con
% filetes superior e inferior. El logotipo de MDPI se sustituye por el de la Escuela de Posgrado.
\ProvidesPackage{water_like}[2026/11/03 Emulación del estilo Water (MDPI)]
\RequirePackage[T1]{fontenc}
\RequirePackage{mathpazo}
\RequirePackage[a4paper,left=2.3cm,right=2.3cm,top=2.6cm,bottom=2.4cm,headheight=14pt,headsep=0.8cm]{geometry}
\RequirePackage{xcolor,graphicx,titlesec,fancyhdr,lastpage,caption,booktabs,array,enumitem,etoolbox,ragged2e}
\definecolor{wblue}{RGB}{0,92,156}
\definecolor{wgrey}{RGB}{90,90,90}
\linespread{1.04}\selectfont
\setlength{\parindent}{0.9cm}\setlength{\parskip}{0pt}
\setlength{\emergencystretch}{2em}
% --- Secciones ---
\titleformat{\section}{\normalfont\bfseries\fontsize{10.5}{12}\selectfont}{\thesection.}{0.6em}{}
\titleformat{\subsection}{\normalfont\itshape\fontsize{10}{12}\selectfont}{\thesubsection.}{0.6em}{}
