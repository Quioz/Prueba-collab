\titlespacing*{\section}{0pt}{16pt plus 3pt minus 2pt}{6pt plus 1pt}
\titlespacing*{\subsection}{0pt}{11pt plus 2pt minus 1pt}{4pt plus 1pt}
% --- Leyendas ---
\captionsetup{font={small},labelfont=bf,labelsep=period,justification=justified,singlelinecheck=false,skip=6pt}
\captionsetup[table]{position=top,skip=5pt}
